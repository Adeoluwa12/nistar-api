NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nistar

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Nistar <noreply@nistar.app>

# Client URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# CORS origins (comma-separated). Auto-accepts all *.vercel.app origins.
# CORS_ORIGINS=https://nistar-V0.vercel.app,https://www.nistar.app

# Super Admin Seed
SUPER_ADMIN_EMAIL=superadmin@nistar.app
SUPER_ADMIN_PASSWORD=SuperSecurePass123!
SUPER_ADMIN_NAME=Super Admin

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# File Upload
MAX_FILE_SIZE=10485760
MAX_DOC_SIZE=10485760
MAX_EPUB_SIZE=31457280

# Field-level encryption (AES-256) for sensitive text (emotional state, etc.)
ENCRYPTION_KEY=change-this-to-a-long-random-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
